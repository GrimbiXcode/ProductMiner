<%= form_with model: [:admin, @currency] do |form| %>
  <div class="space-y-12">
    <div class="border-b border-gray-900/10 pb-12">
      <h2 class="text-base/7 font-semibold text-gray-900"><%=t "admin.currencies.form.subtitle" %></h2>
      <p class="mt-1 text-sm/6 text-gray-600">This information will be displayed publicly so be careful what you share.</p>
      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <div class="mt-2">
            <%= form.label :label, t("admin.currencies.form.label"), class: "block text-sm/6 font-medium text-gray-900" %>
            <%= form.text_field :label, autocomplete: "off", placeholder: "CHF", class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
          </div>
          <div class="mt-2">
            <%= form.label :name, t("admin.currencies.form.name"), class: "block text-sm/6 font-medium text-gray-900" %>
            <%= form.text_field :name, autocomplete: "off", placeholder: "Swiss Franc", class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-between gap-x-6">
    <% if form.object.persisted? %>
      <%= link_to t("general.delete", default: "Delete"), [:admin, form.object], data: { turbo_method: :delete, turbo_confirm: t("general.confirm_delete", default: "Are you sure you want to delete this?") }, class: "text-sm/6 font-semibold text-red-600 hover:text-red-500" %>
    <% else %>
      <span></span>
    <% end %>
    <div class="flex items-center gap-x-6">
      <%= link_to t("general.cancel", default: "Cancel"), admin_currencies_path, type: "button", class: "text-sm/6 font-semibold text-gray-900" %>
      <%= form.submit class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    </div>
  </div>
<% end %>
